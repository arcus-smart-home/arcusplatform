FROM arm32v7/debian:bookworm

# Install all deps
RUN apt-get update && apt-get install -y \
    gcc g++ make \
    openjdk-17-jdk-headless git \
    libapr1-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-armhf

# Clone sources
RUN git clone --branch netty-tcnative-parent-2.0.75.Final --depth 1 https://github.com/netty/netty-tcnative /tmp/tcnative
RUN git clone --branch netty-4.1.60.Final --depth 1 https://github.com/netty/netty /tmp/netty
RUN git clone --branch netty-jni-util-0.0.10.Final --depth 1 https://github.com/netty/netty-jni-util /tmp/netty-jni-util

# Build tcnative JNI library against system OpenSSL
RUN cd /tmp/tcnative/openssl-dynamic/src/main/c && \
    gcc -shared -o /tmp/libnetty_tcnative_linux_arm_32.so \
    -I $JAVA_HOME/include -I $JAVA_HOME/include/linux \
    -I /usr/include/openssl \
    -I /usr/include/apr-1.0 \
    -I /tmp/netty-jni-util/src/main/c \
    -I . \
    -D_LARGEFILE64_SOURCE -O2 -fPIC \
    *.c /tmp/netty-jni-util/src/main/c/*.c \
    -lssl -lcrypto -lapr-1 -lpthread -ldl

# Build epoll native library
RUN cd /tmp/netty && \
    gcc -shared -o /tmp/libnetty_transport_native_epoll_linux_arm_32.so \
    -I $JAVA_HOME/include -I $JAVA_HOME/include/linux \
    -I /tmp/netty-jni-util/src/main/c \
    -I transport-native-unix-common/src/main/c \
    -I transport-native-epoll/src/main/c \
    -O2 -fPIC \
    /tmp/netty-jni-util/src/main/c/*.c \
    transport-native-unix-common/src/main/c/*.c \
    transport-native-epoll/src/main/c/*.c

# Strip and copy results to output
RUN mkdir /output && \
    strip /tmp/libnetty_tcnative_linux_arm_32.so && \
    strip /tmp/libnetty_transport_native_epoll_linux_arm_32.so && \
    cp /tmp/libnetty_tcnative_linux_arm_32.so /output/ && \
    cp /tmp/libnetty_transport_native_epoll_linux_arm_32.so /output/ && \
    ls -la /output/

# Build:
#   docker build --platform linux/arm/v7 -f Dockerfile.netty-arm32-openssl -t netty-arm32-openssl .
#   docker create --name netty-out netty-arm32-openssl
#   docker cp netty-out:/output/ ./netty-arm32-output
#   docker rm netty-out
#
# Install output files:
#   epoll .so  → package into a jar and place in libs/:
#     mkdir -p META-INF/native
#     cp netty-arm32-output/libnetty_transport_native_epoll_linux_arm_32.so META-INF/native/
#     jar cf netty-transport-native-epoll-4.1.60.Final-linux-arm_32.jar META-INF/
#     rm -rf META-INF
#   tcnative .so → copy to agent dist lib dirs:
#     agent/arcus-hal/hub-v2/src/dist/main/lib/libnetty_tcnative_linux_arm_32.so
#     agent/arcus-hal/hub-v2/src/dist/main/lib/v2/libnetty_tcnative_linux_arm_32.so
#
# On the hub (for manual testing):
#   epoll jar  → /data/agent/libs/
#   tcnative .so → /data/agent/lib/
#
# One-liner (from libs/ directory):
#   docker build --platform linux/arm/v7 -f Dockerfile.netty-arm32-openssl -t netty-arm32-openssl . && docker rm netty-out 2>/dev/null; docker create --name netty-out netty-arm32-openssl && docker cp netty-out:/output/ ./netty-arm32-output && docker rm netty-out && cp netty-arm32-output/libnetty_tcnative_linux_arm_32.so ../agent/arcus-hal/hub-v2/src/dist/main/lib/ && cp netty-arm32-output/libnetty_tcnative_linux_arm_32.so ../agent/arcus-hal/hub-v2/src/dist/main/lib/v2/ && mkdir -p META-INF/native && cp netty-arm32-output/libnetty_transport_native_epoll_linux_arm_32.so META-INF/native/ && jar cf netty-transport-native-epoll-4.1.60.Final-linux-arm_32.jar META-INF/ && rm -rf META-INF
#
# Note: The tcnative .so dynamically links against libssl/libcrypto/libapr-1.
# The hub must have openssl and apr installed (both are standard in Yocto).
# CVE patches to OpenSSL come through normal Yocto updates — no .so rebuild needed.
