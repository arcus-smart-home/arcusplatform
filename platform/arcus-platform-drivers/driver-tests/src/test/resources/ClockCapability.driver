driver 'ClockCapability'
version '1.0'
vendor 'Iris'
model 'TestCase'
deviceTypeHint 'TestCase'
matcher vendor: ~/.*/
capabilities DeviceMock, Clock

onConnected {
   Clock.hour 7

   if(null != Clock.hour.get()) {
      Clock.minute(Clock.hour.get() + 1)
   }

   [9].each { second -> Clock.second second }

   Clock.day readHourInMethod()
}

def readHourInMethod() {
   return Clock.hour.get()
}

onPlatform(DeviceMock.Connect) {
   connected();
   sendResponse DeviceMock.ConnectResponse.NAME, [:]
}
