/**
 * Driver for a Minoston MP21ZD Smart Plug Dimmer
 *
 * Z-Wave 800 Series indoor plug-in dimmer.
 * Max load: 200W incandescent, 100W dimmable CFL/LED.
 *
 * FACTORY RESET:  Press the button twice quickly, then hold the third press for 10 seconds.
 * PAIR/INCLUDE:   Press the button 3 times quickly while the hub is in inclusion mode.
 * UNPAIR/EXCLUDE: Press the button 3 times quickly while the hub is in exclusion mode.
 *
 * Configuration parameters follow the MP21ZD (800 Series) manual. The Z-Wave JS
 * entry lists the auto-off timer as parameter 3; the manual, and the first
 * Z-Wave JS entry for this device, put it at parameter 4 with size 4.
 *
 * Command Classes:
 *   0x26   (38) Switch_Multilevel
 *   0x55   (85) Transport Service
 *   0x59   (89) Association Group Info
 *   0x5A   (90) Device Reset Locally
 *   0x5E   (94) Z-Wave+ Info
 *   0x6C  (108) Supervision
 *   0x70  (112) Configuration
 *   0x72  (114) Manufacturer_Specific
 *   0x73  (115) Power Level
 *   0x7A  (122) Firmware Update Meta Data
 *   0x85 (-123) Association
 *   0x86 (-122) Version
 *   0x87 (-121) Indicator
 *   0x8E (-114) Multi Channel Association
 *   0x9F  (-97) Security S2
 */
import groovy.transform.Field

importCapability 'zwave/GenericZWaveDim'
importCapability 'zwave/GenericZWaveVersion'


driver          "ZWMinostonMP21ZDDimmerPlugDriver"
description     "Driver for a Minoston MP21ZD Smart Plug Dimmer"
version         "2.4"
protocol        "ZWAV"
deviceTypeHint  "Dimmer"
productId       "d3120d"
vendor          "Minoston"
model           "MP21ZD"

matcher         'ZWAV:Manufacturer': 0x0312, 'ZWAV:ProductType': 0xFF00, 'ZWAV:ProductId': 0xFF0D


////////////////////////////////////////////////////////////////////////////////
// Capability Declarations
////////////////////////////////////////////////////////////////////////////////

capabilities    DevicePower, Switch, Dimmer

DevicePower.source               DevicePower.SOURCE_LINE
DevicePower.linecapable          true
DevicePower.backupbatterycapable false

Switch.state                     Switch.STATE_OFF

Dimmer.brightness                100


////////////////////////////////////////////////////////////////////////////////
// Device Settings
////////////////////////////////////////////////////////////////////////////////

deviceSettings {
   param name: 'ledIndicator', id: 2, size: 1,
       type: 'enum', values: ['0': 'On when load off', '1': 'On when load on', '2': 'Always off', '3': 'Always on'],
       description: 'Parameter 2: LED indicator behavior',
       dflt: 0
   param name: 'autoOffTimer', id: 4, size: 4,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 4: Auto off timer in minutes (0=disabled)',
       dflt: 0
   param name: 'autoOnTimer', id: 6, size: 4,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 6: Auto on timer in minutes (0=disabled)',
       dflt: 0
   param name: 'nightLightBrightness', id: 7, size: 1,
       type: 'range', min: 1, max: 10,
       description: 'Parameter 7: Night light brightness (1-10, each unit = 10%)',
       dflt: 2
   param name: 'stateAfterPowerFailure', id: 8, size: 1,
       type: 'enum', values: ['0': 'Off', '1': 'On', '2': 'Previous state'],
       description: 'Parameter 8: State after power failure',
       dflt: 2
   param name: 'dimmingRateOnOff', id: 9, size: 1,
       type: 'range', min: 0, max: 10,
       description: 'Parameter 9: Dimming speed for on/off in seconds (0=instant)',
       dflt: 2
   param name: 'dimmingRateManual', id: 10, size: 1,
       type: 'range', min: 1, max: 10,
       description: 'Parameter 10: Dimming speed when holding the button or dimming from the hub (seconds)',
       dflt: 4
   param name: 'minimumDimLevel', id: 11, size: 1,
       type: 'range', min: 0, max: 99,
       description: 'Parameter 11: Minimum dim level (0=disabled, 1-99)',
       dflt: 10
   param name: 'maximumDimLevel', id: 12, size: 1,
       type: 'range', min: 0, max: 99,
       description: 'Parameter 12: Maximum dim level (0=disabled, 1-99)',
       dflt: 99
}

@Field final String DEVICE_NAME = "Minoston MP21ZD Dimmer Plug"

final int OFFLINE_TIMEOUT_SECS    = 10800       // 3 hrs
final int POLLING_INTERVAL_SEC    = 3600        // every hour


////////////////////////////////////////////////////////////////////////////////
// Driver Lifecycle Callbacks
////////////////////////////////////////////////////////////////////////////////

onAdded {
   log.debug "{} added with Attributes {}", DEVICE_NAME, message.attributes

   DevicePower.sourcechanged  ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : now())
   Switch.state               Switch.STATE_OFF
   Switch.statechanged        ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : now())
   Dimmer.brightness          100
}

onConnected {
   log.debug "{} connected", DEVICE_NAME

   ZWave.setOfflineTimeout(OFFLINE_TIMEOUT_SECS)
   ZWave.poll(POLLING_INTERVAL_SEC, ZWave.switch_multilevel.get)

   vars.'MAX_READBACKS' = 10
   vars.'DFLT_READBACK_DELAY' = 1000

   ZWave.switch_multilevel.get()

   // set Association Group 1 (Lifeline) to hub
   ZWave.association.set( 1, 1, 0, 0, 0);

   // Configuration is left to device settings; nothing is written here, so a
   // reconnect never overwrites a value the user changed.
}

onDisconnected {
   log.debug "{} disconnected", DEVICE_NAME
}

onRemoved {
   log.debug "{} removed", DEVICE_NAME
}


////////////////////////////////////////////////////////////////////////////////
// Capability Support
////////////////////////////////////////////////////////////////////////////////

setAttributes() {
   GenericZWaveDim.handleSetAttributes(this, DEVICE_NAME, message)
}

onDimmer.RampBrightness {
   GenericZWaveDim.handleRampBrightness(this, DEVICE_NAME, message)
}

onDimmer.IncrementBrightness {
   GenericZWaveDim.handleIncrementBrightness(this, DEVICE_NAME, message)
}

onDimmer.DecrementBrightness {
   GenericZWaveDim.handleDecrementBrightness(this, DEVICE_NAME, message)
}


////////////////////////////////////////////////////////////////////////////////
// Protocol Message Callbacks
////////////////////////////////////////////////////////////////////////////////

onZWaveMessage.switch_multilevel.report {
   GenericZWaveDim.handleMultilevelReport(this, DEVICE_NAME, message)
}

onZWaveMessage.configuration.report {
   log.trace "{} Config Report: {}", DEVICE_NAME, message
   int param = message.command.get('param') & 0xFF
   int byteCnt = message.command.get('level') & 0x07
   long val1 = message.command.get('val1') & 0xFF
   if (2 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      val1 = (val1 * 256) + val2
   } else if (4 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      long val3 = message.command.get('val3') & 0xFF
      long val4 = message.command.get('val4') & 0xFF
      val1 = (val1 * 256 * 256 * 256) + (val2 * 256 * 256) + (val3 * 256) + val4
   }
   log.debug "{} Config Param:{}, Bytes:{}, Val:{}", DEVICE_NAME, param, byteCnt, val1
}

onZWaveMessage.zwaveplus_info.report {
   def zwVer = message.command.get('zwaveversion')
   def roleType = message.command.get('roletype')
   def nodeType = message.command.get('nodetype')
   log.info "{} ZWave Plus Info, ZWave Ver:{}, RoleType:{}, NodeType:{}", DEVICE_NAME, zwVer, roleType, nodeType
}

onZWaveMessage.device_reset_locally.notification {
   log.info "{} Device Reset Locally Notification", DEVICE_NAME
}

onZWaveNodeInfo {
   log.debug "{} reported Node Info: {}, {}, {}, {}, {}", DEVICE_NAME, message.getNodeId(), message.getStatus(), message.getBasic(), message.getGeneric(), message.getSpecific()
   // defer read to pick up any local changes
   GenericZWaveDim.scheduleDeferredReadLevel(this, 5000)
}

onZWaveMessage {
   log.debug "{} received unhandled ZWave message {}", DEVICE_NAME, message
   return false;
}
