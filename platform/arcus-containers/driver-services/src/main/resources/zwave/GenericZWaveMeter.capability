import groovy.transform.Field

capability     PowerUse
description    "Decodes Z-Wave Meter Reports into the PowerUse capability"
version        "1.0"

// Meter Report payload (Meter command class v1-v6):
//   byte 0      bit 7 = scale bit 2, bits 5-6 = rate type, bits 0-4 = meter type
//   byte 1      bits 5-7 = precision, bits 3-4 = scale bits 0-1, bits 0-2 = value size (1, 2 or 4)
//   byte 2..    signed big-endian value, then (v2+) delta time and previous value

@Field final static int METER_TYPE_ELECTRIC = 0x01
@Field final static int RATE_TYPE_EXPORT    = 0x02
@Field final static int SCALE_KWH           = 0
@Field final static int SCALE_WATTS         = 2

/**
 * Decodes the raw bytes of a Meter Report into meterType, rateType, scale, precision, size and value
 * (the reading with the precision applied). Returns null if the report is too short or the size is not 1, 2 or 4.
 */
static Map decodeMeterReport(byte[] bytes) {
   if (null == bytes || 2 > bytes.length) {
      return null
   }
   int size = bytes[1] & 0x07
   if (!(size in [1, 2, 4]) || bytes.length < 2 + size) {
      return null
   }
   long raw = bytes[2]                          // the most significant byte carries the sign
   for (int i = 3; i < 2 + size; i++) {
      raw = (raw << 8) | (bytes[i] & 0xFF)
   }
   int precision = (bytes[1] & 0xE0) >> 5
   return [
      meterType: bytes[0] & 0x1F,
      rateType:  (bytes[0] & 0x60) >> 5,
      scale:     ((bytes[0] & 0x80) >> 5) | ((bytes[1] & 0x18) >> 3),
      precision: precision,
      size:      size,
      value:     raw / Math.pow(10, precision)
   ]
}

/**
 * Decodes a Meter Report and returns it only if it is an electric meter reading of energy consumed (kWh) or of
 * power (W). Returns null for malformed reports, other meter types, exported energy, and the kVAh, pulse count,
 * V, A and power factor scales, so none of those reach pow:cumulative or pow:instantaneous.
 */
static Map decodeElectricReport(ctx, name, message) {
   def report = decodeMeterReport(message.command.recvBytes)
   ctx.log.debug "{} meter report: {}", name, report
   if (null == report || METER_TYPE_ELECTRIC != report.meterType) {
      return null
   }
   if (SCALE_WATTS == report.scale) {
      // the rate type is not checked for power: the GE/Jasco 40A switch marks its W reports as produced (rate type 2)
      // while it is drawing power
      return report
   }
   if (SCALE_KWH == report.scale && RATE_TYPE_EXPORT != report.rateType) {
      return report
   }
   return null
}

/**
 * True if a report from decodeElectricReport is cumulative energy (kWh), false if it is power (W).
 */
static boolean isEnergy(Map report) {
   return SCALE_KWH == report.scale
}

/**
 * Sets pow:cumulative (Wh) from kWh reports and pow:instantaneous (W) from Watt reports, and ignores everything else.
 */
static void handleMeterReport(ctx, name, message) {
   def report = decodeElectricReport(ctx, name, message)
   if (null == report) {
      return
   }
   if (isEnergy(report)) {
      ctx.PowerUse.cumulative report.value * 1000      // capability units are Watt Hours, not kWh
   } else {
      ctx.PowerUse.instantaneous report.value
   }
}
