/**
 * Driver for a Zooz ZEN52 Double Relay
 *
 * The ZEN52 is a dry-contact double relay with two independently controlled
 * relay outputs. Each relay is exposed as a separate Z-Wave multi-channel
 * endpoint (1, 2).
 *
 * FACTORY RESET:  Click the Z-Wave button 2 times quickly, then hold for at
 *                 least 10 seconds. The LED will blink to confirm.
 *
 * PAIR/INCLUDE:   Click the Z-Wave button 3 times quickly while the hub is in inclusion mode.
 * UNPAIR/EXCLUDE: Click the Z-Wave button 3 times quickly while the hub is in exclusion mode.
 *
 * Command Classes:
 *   0x20   (32) Basic
 *   0x25   (37) Switch_Binary
 *   0x55   (85) Transport Service
 *   0x59   (89) Association Group Info
 *   0x5A   (90) Device Reset Locally
 *   0x5E   (94) Z-Wave+ Info
 *   0x60   (96) Multi Channel
 *   0x6C  (108) Supervision
 *   0x70  (112) Configuration
 *   0x72  (114) Manufacturer_Specific
 *   0x73  (115) Power Level
 *   0x7A  (122) Firmware Update Meta Data
 *   0x85 (-123) Association
 *   0x86 (-122) Version
 *   0x8E (-114) Multi Channel Association
 *   0x9F  (-97) Security S2
 */
import groovy.transform.Field

importCapability 'zwave/GenericZWaveVersion'


driver          "ZWZoozZen52DoubleRelayDriver"
description     "Driver for a Zooz ZEN52 Double Relay"
version         "1.0"
protocol        "ZWAV"
deviceTypeHint  "Switch"
productId       "d3e052"
vendor          "Zooz"
model           "ZEN52"

matcher         'ZWAV:Manufacturer': 0x027A, 'ZWAV:ProductType': 0x0104, 'ZWAV:ProductId': 0x0202
matcher         'ZWAV:Manufacturer': 0x027A, 'ZWAV:ProductType': 0x0904, 'ZWAV:ProductId': 0x0202    // Long Range variant


////////////////////////////////////////////////////////////////////////////////
// Capability Declarations
////////////////////////////////////////////////////////////////////////////////

DevicePower.source               DevicePower.SOURCE_LINE
DevicePower.linecapable          true
DevicePower.backupbatterycapable false

instance 'relay1', Switch
instance 'relay2', Switch


////////////////////////////////////////////////////////////////////////////////
// Device Settings -- exposing Z-Wave config params to clients
////////////////////////////////////////////////////////////////////////////////

deviceSettings {
   param name: 'ledR1', id: 2, size: 1,
       type: 'enum', values: ['0': 'LED Disabled', '1': 'LED Enabled'],
       description: 'Parameter 2: LED indicator for Relay 1',
       dflt: 0

   param name: 'autoOffR1', id: 3, size: 2,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 3: Auto turn-off timer for Relay 1 (0=disabled)',
       dflt: 0

   param name: 'autoOnR1', id: 4, size: 2,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 4: Auto turn-on timer for Relay 1 (0=disabled)',
       dflt: 0

   param name: 'autoOffR2', id: 5, size: 2,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 5: Auto turn-off timer for Relay 2 (0=disabled)',
       dflt: 0

   param name: 'autoOnR2', id: 6, size: 2,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 6: Auto turn-on timer for Relay 2 (0=disabled)',
       dflt: 0

   param name: 'timerUnitR1', id: 7, size: 1,
       type: 'enum', values: ['1': 'Minutes', '2': 'Seconds'],
       description: 'Parameter 7: Timer unit for Relay 1',
       dflt: 1

   param name: 'timerUnitR2', id: 8, size: 1,
       type: 'enum', values: ['1': 'Minutes', '2': 'Seconds'],
       description: 'Parameter 8: Timer unit for Relay 2',
       dflt: 1

   param name: 'powerFailureR1', id: 14, size: 1,
       type: 'enum', values: ['0': 'Off', '1': 'On', '2': 'Restore Last State'],
       description: 'Parameter 14: State after power failure for Relay 1',
       dflt: 2

   param name: 'powerFailureR2', id: 15, size: 1,
       type: 'enum', values: ['0': 'Off', '1': 'On', '2': 'Restore Last State'],
       description: 'Parameter 15: State after power failure for Relay 2',
       dflt: 2

   param name: 'sceneControl', id: 16, size: 1,
       type: 'enum', values: ['0': 'Disabled', '1': 'Enabled'],
       description: 'Parameter 16: Scene control (multi-tap detection)',
       dflt: 0

   param name: 'smartSwitchR1', id: 17, size: 1,
       type: 'enum', values: ['0': 'Local disabled', '1': 'Local and Z-Wave enabled', '2': 'Both disabled'],
       description: 'Parameter 17: Smart switch mode for Relay 1',
       dflt: 1

   param name: 'smartSwitchR2', id: 18, size: 1,
       type: 'enum', values: ['0': 'Local disabled', '1': 'Local and Z-Wave enabled', '2': 'Both disabled'],
       description: 'Parameter 18: Smart switch mode for Relay 2',
       dflt: 1

   param name: 'switchTypeR1', id: 20, size: 1,
       type: 'enum', values: ['0': 'Toggle', '1': 'Momentary', '2': 'Toggle + Manual', '3': 'Momentary + Manual'],
       description: 'Parameter 20: External switch type for Relay 1',
       dflt: 0

   param name: 'switchTypeR2', id: 21, size: 1,
       type: 'enum', values: ['0': 'Toggle', '1': 'Momentary', '2': 'Toggle + Manual', '3': 'Momentary + Manual'],
       description: 'Parameter 21: External switch type for Relay 2',
       dflt: 0

   param name: 'relayTypeR1', id: 25, size: 1,
       type: 'enum', values: ['0': 'Bistable (Latching)', '1': 'Monostable'],
       description: 'Parameter 25: Relay type for Relay 1',
       dflt: 0

   param name: 'relayTypeR2', id: 26, size: 1,
       type: 'enum', values: ['0': 'Bistable (Latching)', '1': 'Monostable'],
       description: 'Parameter 26: Relay type for Relay 2',
       dflt: 0
}


@Field final String DEVICE_NAME = "Zooz ZEN52 Double Relay"

final int OFFLINE_TIMEOUT_SECS = 11400        // 190 minutes
final int POLLING_INTERVAL_SEC = 3600         // Ask for current state every 60 minutes

@Field final byte SWITCH_ON               = 0xff
@Field final byte SWITCH_OFF              = 0x00

// Multi Channel endpoints
@Field final byte ENDPOINT_RELAY_1        = 0x01
@Field final byte ENDPOINT_RELAY_2        = 0x02

// Z-Wave Command Class and Command IDs
@Field final byte CMD_CLASS_SWITCH_BINARY = 0x25
@Field final byte CMD_SWITCH_SET          = 0x01
@Field final byte CMD_SWITCH_GET          = 0x02
@Field final byte CMD_SWITCH_REPORT       = 0x03


// Config Parameters
// ----------------------------------------------------------------------------
@Field final byte CNFG_POWER_FAILURE_R1_PARAM_NO  = 14
final byte CNFG_POWER_FAILURE_R1_SIZE             = 1
final byte CNFG_POWER_FAILURE_R1_VALUE            = 2       // restore last state

@Field final byte CNFG_POWER_FAILURE_R2_PARAM_NO  = 15
final byte CNFG_POWER_FAILURE_R2_SIZE             = 1
final byte CNFG_POWER_FAILURE_R2_VALUE            = 2       // restore last state


////////////////////////////////////////////////////////////////////////////////
// Driver Lifecycle Callbacks
////////////////////////////////////////////////////////////////////////////////

onAdded {
   DevicePower.sourcechanged  ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : now())
   Switch.state.relay1        Switch.STATE_OFF
   Switch.statechanged.relay1 ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : now())
   Switch.state.relay2        Switch.STATE_OFF
   Switch.statechanged.relay2 ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : now())
}

onConnected {
   ZWave.setOfflineTimeout( OFFLINE_TIMEOUT_SECS )

   // request current state for both relays via multi-channel encapsulation
   ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_1, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_GET )
   ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_2, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_GET )

   ZWave.switch_binary.get()
   ZWave.poll(POLLING_INTERVAL_SEC, ZWave.switch_binary.get)

   // set Association to Group 1, Node 1
   ZWave.association.set( 1, 1, 0, 0, 0);

   // configure device
   ZWave.configuration.set( CNFG_POWER_FAILURE_R1_PARAM_NO, CNFG_POWER_FAILURE_R1_SIZE, CNFG_POWER_FAILURE_R1_VALUE )
   ZWave.configuration.set( CNFG_POWER_FAILURE_R2_PARAM_NO, CNFG_POWER_FAILURE_R2_SIZE, CNFG_POWER_FAILURE_R2_VALUE )
}


////////////////////////////////////////////////////////////////////////////////
// Handle Switch Capability
////////////////////////////////////////////////////////////////////////////////

setAttributes('swit') {
   def attributes = message.attributes
   log.debug "setAttributes('swit'): {} ", attributes
   for(attribute in attributes) {
      switch(attribute.key) {
         case Switch.state.relay1:
            byte targetState = attribute.value == 'ON' ? SWITCH_ON : SWITCH_OFF
            log.trace "Set Relay 1: {}", attribute.value
            ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_1, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_SET, targetState )
            ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_1, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_GET )
            break

         case Switch.state.relay2:
            byte targetState = attribute.value == 'ON' ? SWITCH_ON : SWITCH_OFF
            log.trace "Set Relay 2: {}", attribute.value
            ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_2, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_SET, targetState )
            ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_2, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_GET )
            break

         default:
            log.warn "Unrecognized attribute: {}", attribute
            break
      }
   }
}


////////////////////////////////////////////////////////////////////////////////
// Protocol Message Callbacks
////////////////////////////////////////////////////////////////////////////////

onZWaveMessage.multi_channel.encapsulate {
   log.trace "Multi Channel Encapsulate: {}", message
   byte source = message.command.get('source')
   byte cmdClass = message.command.get('command_class')
   byte cmd = message.command.get('command')
   byte[] bytes = message.command.recvBytes
   log.trace "Source:{}, CmdClass:{}, Command:{}, MsgBytes:{}", source, cmdClass, cmd, bytes

   if (CMD_CLASS_SWITCH_BINARY == cmdClass && CMD_SWITCH_REPORT == cmd) {
      byte switchValue = message.command.get('parameter1')

      if (ENDPOINT_RELAY_1 == source) {
         def prevState = Switch.state.relay1.get()
         Switch.state.relay1 (switchValue == SWITCH_ON ? Switch.STATE_ON : Switch.STATE_OFF)
         log.trace "Relay 1: {}", Switch.state.relay1.get()
         if (Switch.state.relay1.get() != prevState) {
            Switch.statechanged.relay1 new Date()
         }
      } else if (ENDPOINT_RELAY_2 == source) {
         def prevState = Switch.state.relay2.get()
         Switch.state.relay2 (switchValue == SWITCH_ON ? Switch.STATE_ON : Switch.STATE_OFF)
         log.trace "Relay 2: {}", Switch.state.relay2.get()
         if (Switch.state.relay2.get() != prevState) {
            Switch.statechanged.relay2 new Date()
         }
      } else {
         log.trace "Switch Binary Report from unexpected endpoint: {}", source
      }
   } else {
      log.trace "Unhandled Encapsulated Message - CmdClass:{}, Cmd:{}", cmdClass, cmd
   }
}

onZWaveMessage.switch_binary.report {
   log.trace "Switch Binary Report (root endpoint): {} -- ignored, using multi-channel reports only", message
   // Root endpoint reports are ambiguous on multi-relay devices -- they may
   // reflect the last-changed relay rather than relay 1, causing cross-relay
   // state corruption.  Rely on multi-channel encapsulated reports instead.
}

onZWaveMessage.basic.report {
   log.trace "Basic Report: {} -- ignored, using multi-channel reports only", message
}

onZWaveMessage.basic.set {
   log.trace "Basic Set: {} -- ignored, using multi-channel reports only", message
}

onZWaveMessage.configuration.report {
   log.trace "Config Report: {}", message
   byte[] bytes = message.command.recvBytes
   int param = message.command.get('param') & 0xFF
   int byteCnt = message.command.get('level') & 0xFF
   long val1 = message.command.get('val1') & 0xFF
   if (2 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      val1 = (val1*256) + val2
   } else if (4 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      long val3 = message.command.get('val3') & 0xFF
      long val4 = message.command.get('val4') & 0xFF
      val1 = (val1*256*256*256) + (val2*256*256) + (val3*256) + val4
   }
   log.debug "Config Param:{}, Bytes: {}, Val: {}", param, byteCnt, val1
}

onZWaveMessage.zwaveplus_info.report {
   def zwVer = message.command.get('zwaveversion')
   def roleType = message.command.get('roletype')
   def nodeType = message.command.get('nodetype')
   log.info "ZWave Plus Info, ZWave Ver:{}, RoleType:{}, NodeType:{}", zwVer, roleType, nodeType
}

onZWaveMessage.device_reset_locally.notification {
   log.info "Device Reset Locally Notification"
}

onZWaveNodeInfo {
   log.trace "Node Info: {}, {}, {}, {}, {}", message.getNodeId(), message.getStatus(), message.getBasic(), message.getGeneric(), message.getSpecific()
   // request current state for both relays
   ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_1, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_GET )
   ZWave.multi_channel.encapsulate( 0x00, ENDPOINT_RELAY_2, CMD_CLASS_SWITCH_BINARY, CMD_SWITCH_GET )
}
