/**
 * Driver for a Zooz ZEN37 4-Button Wall Remote
 *
 * The ZEN37 is a battery-powered Z-Wave 700 series wall remote with four buttons.
 * Each button supports single tap, double tap, triple tap, 4x tap, 5x tap, held,
 * and released actions via the Central Scene command class.
 *
 * Layout:
 *   +---------------------------+
 *   |        Button 1 (top)     |   Scene 1
 *   +---------------------------+
 *   |       Button 2 (middle)   |   Scene 2
 *   +-------------+-------------+
 *   | Button 3    | Button 4    |   Scene 3  |  Scene 4
 *   | (bottom-L)  | (bottom-R)  |
 *   +-------------+-------------+
 *
 * FACTORY RESET:  Click the bottom right button (4) 6 times quickly, the LED will blink red,
 *                 then immediately click it 6 more times. LED stays red for 2 seconds.
 *
 * WAKE UP:        Click the bottom left button (3) 6 times quickly. LED stays solid blue
 *                 while awake, turns off when Z-Wave radio sleeps again.
 *
 * PAIR/INCLUDE:   Put the hub in inclusion mode, then click the top button 7-8 times quickly.
 * UNPAIR/EXCLUDE: Put the hub in exclusion mode, then click the middle button 6 times quickly.
 *
 * Command Classes:
 *   0x20   (32) Basic
 *   0x55   (85) Transport Service V2
 *   0x59   (89) Association Group Info V3
 *   0x5A   (90) Device Reset Locally
 *   0x5B   (91) Central Scene V3
 *   0x5E   (94) Z-Wave+ Info V2
 *   0x6C  (108) Supervision
 *   0x70  (112) Configuration V4
 *   0x71  (113) Notification V8
 *   0x72  (114) Manufacturer Specific
 *   0x73  (115) Power Level
 *   0x7A  (122) Firmware Update Meta Data V5
 *   0x80 (-128) Battery
 *   0x84 (-124) Wake Up V2
 *   0x85 (-123) Association V3
 *   0x86 (-122) Version V2
 *   0x87 (-121) Indicator V3
 *   0x8E (-114) Multi Channel Association V4
 *   0x9F  (-97) Security 2
 *
 * Association Groups:
 *   Group 1: Lifeline (1 node)  - controller reports
 *   Group 2: Basic Set (10 nodes) - on/off via single click (buttons 1/2)
 *   Group 3: Basic Set (10 nodes) - on/off via single click (buttons 3/4)
 *   Group 4: Switch Multilevel (10 nodes) - dimming via press-and-hold (buttons 1/2)
 *   Group 5: Switch Multilevel (10 nodes) - dimming via press-and-hold (buttons 3/4)
 *   Group 6: Toggle (10 nodes) - button 1
 *   Group 7: Toggle (10 nodes) - button 2
 *   Group 8: Toggle (10 nodes) - button 3
 *   Group 9: Toggle (10 nodes) - button 4
 */
import groovy.transform.Field

uses 'zwave.GenericZWaveBattery'
uses 'zwave.GenericZWaveVersion'


driver          "ZWZoozZen37_4ButtonRemoteDriver"
description     "Driver for a Zooz ZEN37 4-Button Wall Remote"
version         "2.4"
protocol        "ZWAV"
deviceTypeHint  "Button"
productId       "a3b737"
vendor          "Zooz"
model           "ZEN37"

matcher         'ZWAV:Manufacturer': 0x027A, 'ZWAV:ProductType': 0x7000, 'ZWAV:ProductId': 0xF003


////////////////////////////////////////////////////////////////////////////////
// Capability Declarations
////////////////////////////////////////////////////////////////////////////////

DevicePower {
   source DevicePower.SOURCE_BATTERY
   linecapable false
   backupbatterycapable false
   bind sourcechanged to source
}

instance 'button1', Button
instance 'button2', Button
instance 'button3', Button
instance 'button4', Button


@Field final String DEVICE_NAME = "Zooz ZEN37 4-Button Remote"

final int OFFLINE_TIMEOUT_SECS = 133200     // 37 hours
final long RELEASE_DELAY_MSEC  = 1000       // simulate button RELEASED 1 second after PRESSED

// Central Scene Key Attributes (bits 0-2 of properties1)
@Field final byte KEY_PRESSED_1_TIME  = 0x00
@Field final byte KEY_RELEASED        = 0x01
@Field final byte KEY_HELD_DOWN       = 0x02
@Field final byte KEY_PRESSED_2_TIMES = 0x03
@Field final byte KEY_PRESSED_3_TIMES = 0x04
@Field final byte KEY_PRESSED_4_TIMES = 0x05
@Field final byte KEY_PRESSED_5_TIMES = 0x06

// Scene Numbers
@Field final byte SCENE_BUTTON_1 = 0x01
@Field final byte SCENE_BUTTON_2 = 0x02
@Field final byte SCENE_BUTTON_3 = 0x03
@Field final byte SCENE_BUTTON_4 = 0x04

// Instance name lookup by scene number
@Field final Map SCENE_TO_INSTANCE = [
   (SCENE_BUTTON_1): 'button1',
   (SCENE_BUTTON_2): 'button2',
   (SCENE_BUTTON_3): 'button3',
   (SCENE_BUTTON_4): 'button4'
]


// Config Parameters
// ----------------------------------------------------------------------------
@Field final byte CNFG_LOW_BATTERY_PARAM_NO        = 1   // Low battery alert threshold
final byte CNFG_LOW_BATTERY_SIZE                   = 1   // 5-10%, default 5
final byte CNFG_LOW_BATTERY_VALUE                  = 5

@Field final byte CNFG_BTN1_LED_COLOR_PARAM_NO     = 2   // Button 1 (top) LED color
final byte CNFG_BTN1_LED_COLOR_SIZE                = 1   // 0=white, 1=purple, 2=orange, 3=cyan, 4=red, 5=green, 6=blue
final byte CNFG_BTN1_LED_COLOR_VALUE               = 0   // default white

@Field final byte CNFG_BTN2_LED_COLOR_PARAM_NO     = 3   // Button 2 (middle) LED color
final byte CNFG_BTN2_LED_COLOR_SIZE                = 1
final byte CNFG_BTN2_LED_COLOR_VALUE               = 1   // default purple

@Field final byte CNFG_BTN3_LED_COLOR_PARAM_NO     = 4   // Button 3 (bottom-left) LED color
final byte CNFG_BTN3_LED_COLOR_SIZE                = 1
final byte CNFG_BTN3_LED_COLOR_VALUE               = 2   // default orange

@Field final byte CNFG_BTN4_LED_COLOR_PARAM_NO     = 5   // Button 4 (bottom-right) LED color
final byte CNFG_BTN4_LED_COLOR_SIZE                = 1
final byte CNFG_BTN4_LED_COLOR_VALUE               = 3   // default cyan

@Field final byte CNFG_LED_BRIGHTNESS_PARAM_NO     = 6   // LED indicator brightness
final byte CNFG_LED_BRIGHTNESS_SIZE                = 1   // 0=off, 1-10 (10%–100%), default 5 (50%)
final byte CNFG_LED_BRIGHTNESS_VALUE               = 5

@Field final byte CNFG_DIMMING_SPEED_PARAM_NO      = 7   // Remote dimming speed (seconds to full brightness)
final byte CNFG_DIMMING_SPEED_SIZE                 = 1   // 1-99 seconds, default 5
final byte CNFG_DIMMING_SPEED_VALUE                = 5

@Field final byte CNFG_BATT_REPORT_FREQ_PARAM_NO   = 8   // Battery reporting frequency (hours)
final byte CNFG_BATT_REPORT_FREQ_SIZE              = 1   // 1-84 hours, default 12
final byte CNFG_BATT_REPORT_FREQ_VALUE             = 12

@Field final byte CNFG_BATT_REPORT_THRESH_PARAM_NO = 9   // Battery reporting threshold (%)
final byte CNFG_BATT_REPORT_THRESH_SIZE            = 1   // 0=disable, 1-20%, default 0
final byte CNFG_BATT_REPORT_THRESH_VALUE           = 0


////////////////////////////////////////////////////////////////////////////////
// Driver Lifecycle Callbacks
////////////////////////////////////////////////////////////////////////////////

onAdded {
   Button.state.button1         Button.STATE_RELEASED
   Button.statechanged.button1  ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : new Date())
   Button.state.button2         Button.STATE_RELEASED
   Button.statechanged.button2  ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : new Date())
   Button.state.button3         Button.STATE_RELEASED
   Button.statechanged.button3  ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : new Date())
   Button.state.button4         Button.STATE_RELEASED
   Button.statechanged.button4  ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : new Date())
}

onConnected {
   ZWave.setOfflineTimeout( OFFLINE_TIMEOUT_SECS )

   // set the wakeup interval to 12 hours (0x00A8C0 = 43200 seconds) for node 0x01
   ZWave.wake_up.set((byte)0x00, (byte)0xA8, (byte)0xC0, (byte)0x01)

   // set Association to Group 1, Node 1
   ZWave.association.set( 1, 1, 0, 0, 0);

   // configure LED brightness
   ZWave.configuration.set( CNFG_LED_BRIGHTNESS_PARAM_NO, CNFG_LED_BRIGHTNESS_SIZE, CNFG_LED_BRIGHTNESS_VALUE )
}


////////////////////////////////////////////////////////////////////////////////
// Scheduled Event Callbacks (button auto-release)
////////////////////////////////////////////////////////////////////////////////

onEvent( "ReleaseButton1" ) {
   Button.state.button1 Button.STATE_RELEASED
   Button.statechanged.button1 new Date()
}

onEvent( "ReleaseButton2" ) {
   Button.state.button2 Button.STATE_RELEASED
   Button.statechanged.button2 new Date()
}

onEvent( "ReleaseButton3" ) {
   Button.state.button3 Button.STATE_RELEASED
   Button.statechanged.button3 new Date()
}

onEvent( "ReleaseButton4" ) {
   Button.state.button4 Button.STATE_RELEASED
   Button.statechanged.button4 new Date()
}


////////////////////////////////////////////////////////////////////////////////
// Protocol Message Callbacks
////////////////////////////////////////////////////////////////////////////////

onZWaveMessage.central_scene.notification {
   def sequenceNumber = message.command.get('sequencenumber')
   def properties1    = message.command.get('properties1')
   def sceneNumber    = message.command.get('scenenumber')
   def keyAttribute   = (properties1 & 0x07)

   log.debug "Central Scene Notification - Sequence:{}, Scene:{}, KeyAttribute:{}", sequenceNumber, sceneNumber, keyAttribute

   def instanceName = SCENE_TO_INSTANCE.get((byte) sceneNumber)
   if (instanceName == null) {
      log.warn "Unexpected scene number: {}", sceneNumber
      return
   }

   if (KEY_RELEASED == keyAttribute) {
      Button.state."${instanceName}" Button.STATE_RELEASED
      Button.statechanged."${instanceName}" new Date()
      log.trace "Button {}: RELEASED", instanceName
   } else {
      Button.state."${instanceName}" Button.STATE_PRESSED
      Button.statechanged."${instanceName}" new Date()
      // auto-release after delay (except for explicit release events)
      def buttonNum = instanceName.replace('button', '')
      Scheduler.scheduleIn "ReleaseButton${buttonNum}", RELEASE_DELAY_MSEC
      log.trace "Button {}: PRESSED (keyAttribute:{})", instanceName, keyAttribute
   }
}

onZWaveMessage.battery.report {
   GenericZWaveBattery.handleBatteryReport(this, DEVICE_NAME, message)
}

onZWaveMessage.wake_up.notification {
   log.trace "Wakeup Notification"
   ZWave.battery.get()
   ZWave.wake_up.no_more_information()
}

onZWaveMessage.configuration.report {
   log.trace "Config Report: {}", message
   byte[] bytes = message.command.recvBytes
   int param = message.command.get('param') & 0xFF
   int byteCnt = message.command.get('level') & 0xFF
   long val1 = message.command.get('val1') & 0xFF
   if (2 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      val1 = (val1*256) + val2
   } else if (4 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      long val3 = message.command.get('val3') & 0xFF
      long val4 = message.command.get('val4') & 0xFF
      val1 = (val1*256*256*256) + (val2*256*256) + (val3*256) + val4
   }
   log.debug "Config Param:{}, Bytes: {}, Val: {}", param, byteCnt, val1
}

onZWaveMessage.zwaveplus_info.report {
   def zwVer = message.command.get('zwaveversion')
   def roleType = message.command.get('roletype')
   def nodeType = message.command.get('nodetype')
   log.info "ZWave Plus Info, ZWave Ver:{}, RoleType:{}, NodeType:{}", zwVer, roleType, nodeType
}

onZWaveMessage.device_reset_locally.notification {
   log.info "Device Reset Locally Notification"
}
