/**
 * Driver for the Ring Alarm Keypad (Z-Wave)
 *
 * The Ring Alarm Keypad is a Z-Wave Plus device that provides PIN entry and
 * arm/disarm buttons for controlling the security alarm subsystem. It uses the
 * Z-Wave Entry Control command class (0x6F) to report button presses and PIN
 * codes entered by the user.
 *
 * FACTORY RESET:
 *   Press and hold the reset button (pinhole on back) for 10 seconds.
 *
 * PAIR:
 *   1. Remove the back cover.
 *   2. Press the pairing button once.
 *   3. The LED ring will flash indicating pairing mode.
 *
 * UNPAIR:
 *   1. Remove the back cover.
 *   2. Press the pairing button once while hub is in exclusion mode.
 *
 * Command Classes:
 *   0x5E   (94) Z-Wave+ Info
 *   0x6C  (108) Supervision
 *   0x6F  (111) Entry Control
 *   0x70  (112) Configuration
 *   0x71  (113) Alarm (Notification)
 *   0x72  (114) Manufacturer Specific
 *   0x73  (115) Power Level
 *   0x7A  (122) Firmware Update MD
 *   0x80 (-128) Battery
 *   0x85 (-123) Association
 *   0x86 (-122) Version
 *   0x87 (-121) Indicator
 *   0x98 (-104) Security
 *   0x9F  (-97) Security 2
 *
 * SECURITY:
 *   The keypad asks for S2 Access Control or S0. S2 Access Control needs the
 *   device's PIN during pairing, so without PIN entry the hub grants S0. It
 *   wraps Entry Control events in Supervision CC (0x6C) either way.
 *
 * HUB DRIVER:
 *   The hub alarm only reaches keypads through a hub driver, so this driver is
 *   a builtin reflex backed by com.iris.agent.reflex.drivers.RingKeyPad. Keep
 *   the two in step. The Z-Wave handlers here run only if a message is forwarded
 *   by the hub; the keypad commands here are the ones the platform sends.
 *
 *   Reference: https://github.com/ImSorryButWho/HomeAssistantNotes/blob/main/RingKeypadV2.md
 */
import groovy.transform.Field

importCapability 'zwave/GenericZWaveBattery'
importCapability 'zwave/GenericZWaveVersion'

driver          "ZWRingKeypad"
description     "Driver for the Ring Alarm Keypad"
version         "1.0"
protocol        "ZWAV"
deviceTypeHint  "KeyPad"
productId       "c2592f"
vendor          "RING"
model           "5AT2S7"

// Ring Alarm Keypad Gen 2
matcher         'ZWAV:Manufacturer': 0x0346, 'ZWAV:ProductType': 0x0101, 'ZWAV:ProductId': 0x0301

capabilities    DevicePower, KeyPad, Alert, Identify


// ########### constants ##################

def final String DEVICE_NAME = "Ring Alarm Keypad"

def final int OFFLINE_TIMEOUT_SECS     = 10800        // 3 hours
def final int POLLING_INTERVAL_SEC     = 3600         // 60 minutes
def final int BATTERY_POLLING_SEC      = 86400        // 24 hours

// Entry Control event types (from Z-Wave Entry Control CC spec, SDS13891)
@Field def final byte EC_EVENT_CACHING_STARTED   = 0x00
@Field def final byte EC_EVENT_CACHING_ENDED     = 0x01
@Field def final byte EC_EVENT_ENTER             = 0x02
@Field def final byte EC_EVENT_DISARM            = 0x03
@Field def final byte EC_EVENT_ARM_ALL           = 0x04
@Field def final byte EC_EVENT_ARM_AWAY          = 0x05
@Field def final byte EC_EVENT_ARM_HOME          = 0x06
@Field def final byte EC_EVENT_EXIT_DELAY        = 0x07
@Field def final byte EC_EVENT_FIRE              = 0x10
@Field def final byte EC_EVENT_POLICE            = 0x11
@Field def final byte EC_EVENT_ALERT_PANIC       = 0x12
@Field def final byte EC_EVENT_ALERT_MEDICAL     = 0x13
@Field def final byte EC_EVENT_CANCEL            = 0x19

// Entry Control data types
@Field def final byte EC_DATATYPE_NA             = 0x00
@Field def final byte EC_DATATYPE_RAW            = 0x01
@Field def final byte EC_DATATYPE_ASCII          = 0x02
@Field def final byte EC_DATATYPE_MD5            = 0x03

// Entry Control configuration
@Field def final byte EC_KEY_CACHE_SIZE          = 0x04     // 4-digit PIN
@Field def final byte EC_KEY_CACHE_TIMEOUT       = 0x05     // 5-second timeout

// Indicator CC V3 indicator ids (SDS13781 table, as zwave-js lists them). The
// keypad only understands V3 indicator objects; a V1 Indicator Set value means
// nothing to it. The ids drive both the keypad's lights and its voice prompts.
@Field def final byte IND_DISARMED        = (byte) 0x02   // Not armed / disarmed
@Field def final byte IND_CODE_REJECTED   = (byte) 0x09   // Code not accepted
@Field def final byte IND_ARMED_STAY      = (byte) 0x0A
@Field def final byte IND_ARMED_AWAY      = (byte) 0x0B
@Field def final byte IND_ALARM_BURGLAR   = (byte) 0x0D   // Alarming: Burglar
@Field def final byte IND_BYPASS_NEEDED   = (byte) 0x10   // Bypass challenge (sensors open)
@Field def final byte IND_ENTRY_DELAY     = (byte) 0x11
@Field def final byte IND_EXIT_DELAY      = (byte) 0x12
@Field def final byte IND_NODE_IDENTIFY   = (byte) 0x50
@Field def final byte IND_CHIME           = (byte) 0x60   // Generic sound 1: the keypad's "ding ding"

// Volume for sounds, 10 to 100 on the keypad
@Field def final byte CHIME_VOLUME        = (byte) 0x32

// Indicator CC V3 property ids
@Field def final byte PROP_MULTILEVEL      = (byte) 0x01
@Field def final byte PROP_ON_OFF_PERIOD   = (byte) 0x03
@Field def final byte PROP_ON_OFF_CYCLES   = (byte) 0x04
@Field def final byte PROP_ON_TIME         = (byte) 0x05
@Field def final byte PROP_TIMEOUT_MINUTES = (byte) 0x06
@Field def final byte PROP_TIMEOUT_SECONDS = (byte) 0x07
@Field def final byte PROP_SOUND_LEVEL     = (byte) 0x09

// clear the accumulated PIN after 5 minutes of no activity
@Field def final String EVENT_CLEAR_PIN     = "ClearPin"
@Field def final long CLEAR_PIN_DELAY_MS    = 5 * 60 * 1000


// ########### initial attribute values ##################

DevicePower {
   source DevicePower.SOURCE_BATTERY
   linecapable true
   backupbatterycapable false
   bind sourcechanged to source
}

Alert {
   state Alert.STATE_QUIET
}

KeyPad {
   alarmState KeyPad.ALARMSTATE_DISARMED
   alarmMode KeyPad.ALARMMODE_ON
   alarmSounder KeyPad.ALARMSOUNDER_ON
   enabledSounds (["BUTTONS", "DISARMED", "ARMED", "ARMING", "SOAKING", "ALERTING"])
}


////////////////////////////////////////////////////////////////////////////////
// Z-Wave Reflexes
////////////////////////////////////////////////////////////////////////////////

ZWave {
   builtin reflex
   offlineTimeout 180, MINUTES
}


////////////////////////////////////////////////////////////////////////////////
// Device settings
//
// Left out on purpose: 1-3 and 21 tune Z-Wave retries and the heartbeat offline
// detection depends on, 23 is read-only and 24 is a one-shot speaker calibration.
////////////////////////////////////////////////////////////////////////////////

deviceSettings {
   param name: 'announcementVolume', id: 4, size: 1,
       type: 'range', min: 0, max: 10,
       description: 'Parameter 4: Voice announcement volume',
       dflt: 7

   param name: 'keyToneVolume', id: 5, size: 1,
       type: 'range', min: 0, max: 10,
       description: 'Parameter 5: Key press tone volume',
       dflt: 6

   param name: 'sirenVolume', id: 6, size: 1,
       type: 'range', min: 0, max: 10,
       description: 'Parameter 6: Siren volume',
       dflt: 10

   param name: 'emergencyLongPress', id: 7, size: 1,
       type: 'range', min: 2, max: 5,
       description: 'Parameter 7: Hold time for the Police, Fire and Medical buttons (seconds)',
       dflt: 3

   param name: 'numberPadLongPress', id: 8, size: 1,
       type: 'range', min: 2, max: 5,
       description: 'Parameter 8: Hold time for a number pad long press (seconds)',
       dflt: 3

   param name: 'proximityDisplayTimeout', id: 9, size: 1,
       type: 'range', min: 0, max: 30,
       description: 'Parameter 9: Time the display stays on after proximity is detected (seconds)',
       dflt: 5

   param name: 'buttonDisplayTimeout', id: 10, size: 1,
       type: 'range', min: 0, max: 30,
       description: 'Parameter 10: Time the display stays on after a button press (seconds)',
       dflt: 5

   param name: 'statusDisplayTimeout', id: 11, size: 1,
       type: 'range', min: 1, max: 30,
       description: 'Parameter 11: Time the display stays on after a status change (seconds)',
       dflt: 5

   param name: 'securityModeBrightness', id: 12, size: 1,
       type: 'range', min: 0, max: 100,
       description: 'Parameter 12: Security mode light brightness (%)',
       dflt: 100

   param name: 'keyBacklightBrightness', id: 13, size: 1,
       type: 'range', min: 0, max: 100,
       description: 'Parameter 13: Key backlight brightness (%)',
       dflt: 100

   param name: 'keyBacklightAmbientLevel', id: 14, size: 1,
       type: 'range', min: 0, max: 100,
       description: 'Parameter 14: Ambient light level above which the key backlight stays off (%)',
       dflt: 20

   param name: 'proximityDetection', id: 15, size: 1,
       type: 'enum', values: ['0': 'Disabled', '1': 'Enabled'],
       description: 'Parameter 15: Proximity detection',
       dflt: 1

   param name: 'ledRampTime', id: 16, size: 1,
       type: 'range', min: 0, max: 255,
       description: 'Parameter 16: LED ramp time',
       dflt: 50

   param name: 'batteryLowThreshold', id: 17, size: 1,
       type: 'range', min: 0, max: 100,
       description: 'Parameter 17: Low battery threshold (%)',
       dflt: 15

   param name: 'language', id: 18, size: 1,
       type: 'enum', values: ['0': 'English', '2': 'French', '5': 'Spanish', '30': 'Keypad default'],
       description: 'Parameter 18: Voice prompt language',
       dflt: 30

   param name: 'batteryWarningThreshold', id: 19, size: 1,
       type: 'range', min: 0, max: 100,
       description: 'Parameter 19: Battery warning threshold (%)',
       dflt: 5

   param name: 'securityModeBlinkDuration', id: 20, size: 1,
       type: 'range', min: 1, max: 60,
       description: 'Parameter 20: Security mode blink duration',
       dflt: 2

   param name: 'securityModeDisplay', id: 22, size: 2,
       type: 'range', min: 0, max: 601,
       description: 'Parameter 22: Security mode display (0=always off, 601=always on)',
       dflt: 0

   param name: 'motionTimeout', id: 26, size: 1,
       type: 'range', min: 0, max: 60,
       description: 'Parameter 26: Motion sensor timeout (seconds)',
       dflt: 3
}


////////////////////////////////////////////////////////////////////////////////
// Driver lifecycle callbacks
////////////////////////////////////////////////////////////////////////////////

onAdded {
   vars.'CURRENT_NAME' = DEVICE_NAME
   log.debug "{} added", DEVICE_NAME
}

onConnected {
   vars.'CURRENT_NAME' = DEVICE_NAME
   log.debug "{} connected", DEVICE_NAME

   ZWave.setOfflineTimeout( OFFLINE_TIMEOUT_SECS )

   // configure Entry Control to cache up to 4 digits with a 5 second timeout
   ZWave.entry_control.config_set( EC_KEY_CACHE_SIZE, EC_KEY_CACHE_TIMEOUT )

   // poll for battery status
   ZWave.battery.get()
   ZWave.poll(BATTERY_POLLING_SEC, ZWave.battery.get)

   // the keypad only reports power changes, so ask whether it is on mains now
   ZWave.alarm.get((byte) 0x00, (byte) 0x08, (byte) 0x00)

   // set the keypad indicator to match the current alarm state
   updateIndicator()
}

onDisconnected {
   log.debug "{} disconnected", DEVICE_NAME
}

onRemoved {
   log.debug "{} removed", DEVICE_NAME
}


////////////////////////////////////////////////////////////////////////////////
// Z-Wave Node Info
////////////////////////////////////////////////////////////////////////////////

onZWaveNodeInfo {
   log.debug "Node Info: {}, {}, {}, {}, {}", message.getNodeId(), message.getStatus(), message.getBasic(), message.getGeneric(), message.getSpecific()
}


////////////////////////////////////////////////////////////////////////////////
// Entry Control Notification Handler
//
// This is the primary input handler for the Ring Keypad. When a user enters a
// PIN and presses an action button (Arm Away, Arm Home, Disarm), the keypad
// sends an Entry Control notification with the event type and PIN data.
////////////////////////////////////////////////////////////////////////////////

onZWaveMessage.entry_control.notification {
   byte[] bytes = message.command.recvBytes
   // Entry Control Notification payload: [seqNo, dataType, eventType, dataLen, ...data]
   if (bytes.length < 4) {
      log.warn "{} Entry Control notification too short: {} bytes", DEVICE_NAME, bytes.length
      return
   }
   int dataType   = bytes[1] & 0xFF
   int eventType  = bytes[2] & 0xFF
   int dataLength = bytes[3] & 0xFF

   log.debug "{} Entry Control notification - eventType:{}, dataType:{}, dataLength:{}", DEVICE_NAME, eventType, dataType, dataLength

   handleEntryControlNotification(bytes, 0)
}


////////////////////////////////////////////////////////////////////////////////
// Supervision CC Handler
//
// The Ring Keypad wraps subsequent Entry Control events in Supervision CC
// (0x6C). This handler unwraps the encapsulated command and sends back a
// Supervision Report to acknowledge receipt.
//
// Supervision Get (Supervision CC v1):
//   [0] = properties: bit 7 status updates requested, bit 6 reserved,
//         bits 0-5 session id
//   [1] = encapsulated command length, counting its command class and
//         command bytes
//   [2] = encapsulated command class
//   [3] = encapsulated command
//   [4..] = encapsulated command payload
//
// The Report must echo the session id in the same low six bits, or the
// keypad treats it as unanswered and sends the Get again.
////////////////////////////////////////////////////////////////////////////////

onZWaveMessage.supervision.get {
   byte[] bytes = message.command.recvBytes
   if (bytes.length < 4) {
      log.warn "{} Supervision Get too short: {} bytes", DEVICE_NAME, bytes.length
      return
   }

   int sessionId = bytes[0] & 0x3F
   int encapLen  = bytes[1] & 0xFF
   int encapCC   = bytes[2] & 0xFF
   int encapCmd  = bytes[3] & 0xFF

   log.debug "{} Supervision Get - sessionId:{}, encapCC:0x{}, encapCmd:0x{}, encapLen:{}",
      DEVICE_NAME, sessionId, Integer.toHexString(encapCC), Integer.toHexString(encapCmd), encapLen

   // Send Supervision Report: status=0xFF (success), duration=0x00, no more updates
   ZWave.sendCommand((byte)0x6C, (byte)0x02,
      (byte)sessionId, (byte)0xFF, (byte)0x00)

   // Handle encapsulated Entry Control notification
   if (encapCC == 0x6F && encapCmd == 0x01) {
      // The encapsulated payload follows its command class and command bytes
      int innerLen = Math.max(0, Math.min(encapLen - 2, bytes.length - 4))
      byte[] innerPayload = new byte[innerLen]
      System.arraycopy(bytes, 4, innerPayload, 0, innerLen)
      handleEntryControlNotification(innerPayload, 0)
   } else {
      log.debug "{} Supervision: unhandled encapsulated CC=0x{}, CMD=0x{}",
         DEVICE_NAME, Integer.toHexString(encapCC), Integer.toHexString(encapCmd)
   }
}


////////////////////////////////////////////////////////////////////////////////
// Entry Control Notification Dispatcher
//
// Shared handler called from both the direct Entry Control handler and the
// Supervision unwrapper. The payload parameter contains the raw Entry Control
// notification bytes starting at the given offset:
//   [offset+0] = sequence number
//   [offset+1] = data type
//   [offset+2] = event type
//   [offset+3] = data length
//   [offset+4..] = data bytes
////////////////////////////////////////////////////////////////////////////////

void handleEntryControlNotification(byte[] payload, int offset) {
   if (payload.length - offset < 4) {
      log.warn "{} Entry Control payload too short", DEVICE_NAME
      return
   }

   int dataType   = payload[offset + 1] & 0xFF
   int eventType  = payload[offset + 2] & 0xFF
   int dataLength = payload[offset + 3] & 0xFF

   String pin = extractPin(payload, offset + 4, dataType, dataLength)

   switch (eventType) {
      case EC_EVENT_ARM_AWAY:
         log.debug "{} Arm Away pressed", DEVICE_NAME
         handleArm(pin, KeyPad.ALARMMODE_ON, false)
         break

      case EC_EVENT_ARM_HOME:
         log.debug "{} Arm Home pressed", DEVICE_NAME
         handleArm(pin, KeyPad.ALARMMODE_PARTIAL, false)
         break

      case EC_EVENT_ARM_ALL:
         log.debug "{} Arm All pressed", DEVICE_NAME
         handleArm(pin, KeyPad.ALARMMODE_ON, false)
         break

      case EC_EVENT_DISARM:
         log.debug "{} Disarm pressed", DEVICE_NAME
         handleDisarm(pin)
         break

      case EC_EVENT_ENTER:
         log.debug "{} Enter pressed", DEVICE_NAME
         // Enter with no specific action — treat as disarm if PIN provided
         if (pin != null && pin.length() > 0) {
            handleDisarm(pin)
         }
         break

      case EC_EVENT_FIRE:
      case EC_EVENT_POLICE:
      case EC_EVENT_ALERT_PANIC:
      case EC_EVENT_ALERT_MEDICAL:
         log.info "{} Panic button held, event type: {}", DEVICE_NAME, eventType
         emit KeyPad.PanicPressed
         break

      case EC_EVENT_CANCEL:
         log.debug "{} Cancel pressed", DEVICE_NAME
         vars.'lastEnteredPIN' = ''
         break

      case EC_EVENT_CACHING_STARTED:
         log.trace "{} PIN entry started", DEVICE_NAME
         break

      case EC_EVENT_CACHING_ENDED:
         log.trace "{} PIN cached: length={}", DEVICE_NAME, dataLength
         if (pin != null && pin.length() > 0) {
            vars.'lastEnteredPIN' = pin
            Scheduler.scheduleIn EVENT_CLEAR_PIN, CLEAR_PIN_DELAY_MS
         }
         break

      default:
         log.warn "{} Unhandled Entry Control event type: {}", DEVICE_NAME, eventType
         break
   }
}


////////////////////////////////////////////////////////////////////////////////
// Arm / Disarm Handlers
////////////////////////////////////////////////////////////////////////////////

void handleArm(String pin, String mode, boolean bypass) {
   // arm does not require PIN validation - the platform decides whether to allow it
   // but if a PIN was provided, try to set the actor for attribution
   if (pin != null && pin.length() > 0) {
      checkPinAndSetActor(pin)
   }
   emit KeyPad.ArmPressed, ["mode": mode, "bypass": bypass]
}

void handleDisarm(String pin) {
   // disarm requires a valid PIN
   if (pin == null || pin.length() == 0) {
      // check if there is a cached PIN from a previous entry
      pin = vars.'lastEnteredPIN' ?: ''
   }

   if (pin.length() == 0) {
      log.debug "{} Disarm pressed with no PIN", DEVICE_NAME
      emit KeyPad.InvalidPinEntered
      setIndicator(IND_CODE_REJECTED)
      return
   }

   if (checkPinAndSetActor(pin)) {
      log.debug "{} Valid PIN, emitting DisarmPressed", DEVICE_NAME
      emit KeyPad.DisarmPressed
   } else {
      log.debug "{} Invalid PIN entered", DEVICE_NAME
      emit KeyPad.InvalidPinEntered
      setIndicator(IND_CODE_REJECTED)
   }

   // clear the cached PIN after use
   vars.'lastEnteredPIN' = ''
}


////////////////////////////////////////////////////////////////////////////////
// PIN Management
////////////////////////////////////////////////////////////////////////////////

boolean checkPinAndSetActor(String pin) {
   if (pin == null || pin.length() == 0) {
      return false
   }
   try {
      def person = PinManagement.validatePin(pin)
      if (person != null) {
         PinManagement.setActor(person)
         return true
      }
      return false
   } catch (e) {
      log.debug "Error validating pin", e
      return false
   }
}

String extractPin(byte[] payload, int offset, int dataType, int dataLength) {
   if (dataLength <= 0 || payload.length < offset + dataLength) {
      return ''
   }

   StringBuilder pin = new StringBuilder()
   for (int i = 0; i < dataLength; i++) {
      int b = payload[offset + i] & 0xFF
      if (dataType == EC_DATATYPE_ASCII) {
         pin.append((char) b)
      } else {
         pin.append(Integer.toString(b))
      }
   }
   return pin.toString()
}


////////////////////////////////////////////////////////////////////////////////
// Scheduled Events
////////////////////////////////////////////////////////////////////////////////

onEvent(EVENT_CLEAR_PIN) {
   log.trace "{} Clearing cached PIN", DEVICE_NAME
   vars.'lastEnteredPIN' = ''
}


////////////////////////////////////////////////////////////////////////////////
// KeyPad Capability Handlers
//
// These are called by the alarm subsystem to update the keypad's display and
// sound state to match the current alarm state.
////////////////////////////////////////////////////////////////////////////////

onKeyPad.BeginArming {
   int delaySecs = message.attributes['delayInS'] ?: 0
   def alarmMode = message.attributes['alarmMode']
   log.debug "{} BeginArming( delayInS:{}, alarmMode:{} )", DEVICE_NAME, delaySecs, alarmMode
   KeyPad.alarmState KeyPad.ALARMSTATE_ARMING
   KeyPad.alarmMode  alarmMode
   sendCountdownIndicator(IND_EXIT_DELAY, delaySecs)
   sendResponse 'keypad:BeginArmingResponse', [:]
}

onKeyPad.Armed {
   def alarmMode = message.attributes['alarmMode']
   log.debug "{} Armed( alarmMode:{} )", DEVICE_NAME, alarmMode
   KeyPad.alarmState KeyPad.ALARMSTATE_ARMED
   KeyPad.alarmMode  alarmMode
   setIndicator(alarmMode == KeyPad.ALARMMODE_PARTIAL ? IND_ARMED_STAY : IND_ARMED_AWAY)
   sendResponse 'keypad:ArmedResponse', [:]
}

onKeyPad.Disarmed {
   log.debug "{} Disarmed()", DEVICE_NAME
   KeyPad.alarmState KeyPad.ALARMSTATE_DISARMED
   KeyPad.alarmMode KeyPad.ALARMMODE_OFF
   setIndicator(IND_DISARMED)
   sendResponse 'keypad:DisarmedResponse', [:]
}

onKeyPad.Soaking {
   int durationSecs = message.attributes['durationInS'] ?: 0
   def alarmMode = message.attributes['alarmMode']
   log.debug "{} Soaking( durationInS:{}, alarmMode:{} )", DEVICE_NAME, durationSecs, alarmMode
   KeyPad.alarmState KeyPad.ALARMSTATE_SOAKING
   KeyPad.alarmMode  alarmMode
   sendCountdownIndicator(IND_ENTRY_DELAY, durationSecs)
   sendResponse 'keypad:SoakingResponse', [:]
}

onKeyPad.Alerting {
   def alarmMode = message.attributes['alarmMode']
   log.debug "{} Alerting( alarmMode:{} )", DEVICE_NAME, alarmMode
   KeyPad.alarmState KeyPad.ALARMSTATE_ALERTING
   KeyPad.alarmMode alarmMode == "PANIC" ? KeyPad.ALARMMODE_OFF : alarmMode
   setIndicator(IND_ALARM_BURGLAR)
   sendResponse 'keypad:AlertingResponse', [:]
}

onKeyPad.Chime {
   log.debug "{} Chime()", DEVICE_NAME
   playSound(IND_CHIME, CHIME_VOLUME)
   sendResponse 'keypad:ChimeResponse', [:]
}

onKeyPad.ArmingUnavailable {
   log.debug "{} ArmingUnavailable()", DEVICE_NAME
   setIndicator(IND_BYPASS_NEEDED)
   sendResponse 'keypad:ArmingUnavailableResponse', [:]
}


////////////////////////////////////////////////////////////////////////////////
// KeyPad / Alert Attribute Handlers
////////////////////////////////////////////////////////////////////////////////

setAttributes('keypad') {
   def attributes = message.attributes
   log.debug "{} setAttributes:keypad - {}", DEVICE_NAME, attributes
   for (attribute in attributes) {
      switch (attribute.key) {
         case KeyPad.alarmState:
            KeyPad.alarmState attribute.value
            break
         case KeyPad.alarmMode:
            KeyPad.alarmMode attribute.value
            break
         case KeyPad.alarmSounder:
            KeyPad.alarmSounder attribute.value
            if (attribute.value == KeyPad.ALARMSOUNDER_ON) {
               KeyPad.enabledSounds (["BUTTONS", "DISARMED", "ARMED", "ARMING", "SOAKING", "ALERTING"])
            } else {
               KeyPad.enabledSounds ([])
            }
            break
         case KeyPad.enabledSounds:
            KeyPad.enabledSounds attribute.value
            KeyPad.alarmSounder attribute.value.size() == 0 ? KeyPad.ALARMSOUNDER_OFF : KeyPad.ALARMSOUNDER_ON
            break
         default:
            break
      }
   }
   updateIndicator()
}

setAttributes('alert') {
   def attributes = message.attributes
   log.debug "{} setAttributes:alert - {}", DEVICE_NAME, attributes
   for (attribute in attributes) {
      switch (attribute.key) {
         case Alert.state:
            Alert.state attribute.value
            if (attribute.value == Alert.STATE_ALERTING) {
               setIndicator(IND_ALARM_BURGLAR)
            } else {
               updateIndicator()
            }
            break
         default:
            break
      }
   }
}


////////////////////////////////////////////////////////////////////////////////
// Identify Capability
////////////////////////////////////////////////////////////////////////////////

onIdentify.Identify {
   log.debug "{} Identify", DEVICE_NAME
   // blink the keypad, then put its state indicator back
   sendIdentifyBlink()
   Scheduler.scheduleIn 'IdentifyDone', 5000
   sendResponse 'ident:IdentifyResponse', [:]
}

onEvent('IdentifyDone') {
   updateIndicator()
}


////////////////////////////////////////////////////////////////////////////////
// Z-Wave Message Handlers
////////////////////////////////////////////////////////////////////////////////

onZWaveMessage.battery.report {
   GenericZWaveBattery.handleBatteryReport(this, DEVICE_NAME, message)
}

onZWaveMessage.alarm.report {
   def notificationType = message.command.get('notificationtype') & 0xFF
   def event = message.command.get('event') & 0xFF
   log.debug "{} Alarm Report - type:{}, event:{}", DEVICE_NAME, notificationType, event

   switch (notificationType) {
      case 0x08:  // Power Management (Notification CC event ids)
         switch (event) {
            case 0x01:  // Power has been applied
            case 0x03:  // AC mains re-connected
               log.info "{} AC power connected", DEVICE_NAME
               DevicePower.source DevicePower.SOURCE_LINE
               break
            case 0x02:  // AC mains disconnected
               log.info "{} Running on battery", DEVICE_NAME
               DevicePower.source DevicePower.SOURCE_BATTERY
               break
            case 0x0A:  // Replace battery soon
            case 0x0B:  // Replace battery now
               log.warn "{} Battery low", DEVICE_NAME
               ZWave.battery.get()
               break
            default:
               log.debug "{} Unhandled power management event: {}", DEVICE_NAME, event
               break
         }
         break

      case 0x09:  // System
         switch (event) {
            case 0x05:  // Heartbeat
               log.trace "{} Heartbeat", DEVICE_NAME
               break
            default:
               log.debug "{} Unhandled system event: {}", DEVICE_NAME, event
               break
         }
         break

      case 0x07:  // Home Security (proximity sensor)
         switch (event) {
            case 0x00:  // State idle
               log.trace "{} Motion cleared", DEVICE_NAME
               break
            case 0x08:  // Motion detected
               log.trace "{} Motion detected (proximity wake)", DEVICE_NAME
               break
            default:
               log.debug "{} Home Security event: {}", DEVICE_NAME, event
               break
         }
         break

      case 0x06:  // Access Control
         log.debug "{} Access Control event: {}", DEVICE_NAME, event
         break

      default:
         log.debug "{} Unhandled notification type:{}, event:{}", DEVICE_NAME, notificationType, event
         break
   }
}

onZWaveMessage.configuration.report {
   byte[] bytes = message.command.recvBytes
   int param = message.command.get('param') & 0xFF
   int byteCnt = message.command.get('level') & 0xFF
   long val1 = message.command.get('val1') & 0xFF
   if (2 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      val1 = (val1 * 256) + val2
   } else if (4 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      long val3 = message.command.get('val3') & 0xFF
      long val4 = message.command.get('val4') & 0xFF
      val1 = (val1 * 256 * 256 * 256) + (val2 * 256 * 256) + (val3 * 256) + val4
   }
   log.debug "{} Config Report - param:{}, bytes:{}, val:{}", DEVICE_NAME, param, byteCnt, val1
}

onZWaveMessage.zwaveplus_info.report {
   def zwVer = message.command.get('zwaveversion')
   def roleType = message.command.get('roletype')
   def nodeType = message.command.get('nodetype')
   log.info "{} ZWave Plus Info - ver:{}, role:{}, node:{}", DEVICE_NAME, zwVer, roleType, nodeType
}

onZWaveMessage.device_reset_locally.notification {
   log.info "{} Device Reset Locally", DEVICE_NAME
}


////////////////////////////////////////////////////////////////////////////////
// Indicator Utility
////////////////////////////////////////////////////////////////////////////////

/**
 * Turn an indicator on. Indicator Set V3: [v1 value=0x00] [object count] then
 * one (indicator id, property id, value) triplet per object.
 */
void setIndicator(byte indicatorId) {
   ZWave.sendCommand(
      (byte) 0x87, (byte) 0x01,
      (byte) 0x00, (byte) 0x01,
      indicatorId, PROP_MULTILEVEL, (byte) 0xFF
   )
}

/**
 * Play one of the keypad's sounds. It starts them from the sound level property
 * alone, with no multilevel object.
 */
void playSound(byte indicatorId, byte volume) {
   ZWave.sendCommand(
      (byte) 0x87, (byte) 0x01,
      (byte) 0x00, (byte) 0x01,
      indicatorId, PROP_SOUND_LEVEL, volume
   )
}

/**
 * Start an indicator's countdown, as zwave-js does for its "timeout" value:
 * minutes in property 0x06 and seconds in property 0x07. Nothing is sent for a
 * zero duration, since the state that follows carries its own indicator.
 */
void sendCountdownIndicator(byte indicatorId, int durationSecs) {
   if (durationSecs <= 0) {
      return
   }
   int minutes = Math.min((int)(durationSecs / 60), 255)
   int seconds = durationSecs % 60
   ZWave.sendCommand(
      (byte) 0x87, (byte) 0x01,
      (byte) 0x00, (byte) 0x02,
      indicatorId, PROP_TIMEOUT_MINUTES, (byte) minutes,
      indicatorId, PROP_TIMEOUT_SECONDS, (byte) seconds
   )
}

/**
 * Blink the keypad to identify it: Node Identify with a 1 s on/off period,
 * three cycles, half of each period on.
 */
void sendIdentifyBlink() {
   ZWave.sendCommand(
      (byte) 0x87, (byte) 0x01,
      (byte) 0x00, (byte) 0x03,
      IND_NODE_IDENTIFY, PROP_ON_OFF_PERIOD, (byte) 0x0A,
      IND_NODE_IDENTIFY, PROP_ON_OFF_CYCLES, (byte) 0x03,
      IND_NODE_IDENTIFY, PROP_ON_TIME, (byte) 0x05
   )
}

void updateIndicator() {
   def alarmState = KeyPad.alarmState.get()
   def alarmMode = KeyPad.alarmMode.get()

   switch (alarmState) {
      case KeyPad.ALARMSTATE_DISARMED:
         setIndicator(IND_DISARMED)
         break
      case KeyPad.ALARMSTATE_ARMING:
      case KeyPad.ALARMSTATE_SOAKING:
         // the remaining delay is unknown here; the next state refreshes the keypad
         break
      case KeyPad.ALARMSTATE_ARMED:
         setIndicator(alarmMode == KeyPad.ALARMMODE_PARTIAL ? IND_ARMED_STAY : IND_ARMED_AWAY)
         break
      case KeyPad.ALARMSTATE_ALERTING:
         setIndicator(IND_ALARM_BURGLAR)
         break
      default:
         setIndicator(IND_DISARMED)
         break
   }
}
