////////////////////////////////////////////////////////////////////////////////
// Default protocol message handlers
////////////////////////////////////////////////////////////////////////////////

onZigbeeMessage(Zigbee.TYPE_ZCL) {
   def zclMsg = Zigbee.Message.toZcl(message)
   def profile = zclMsg.getProfileId()
   def clusterId = zclMsg.getClusterId()
   def messageId = zclMsg.getZclMessageId()
   def endpoint = zclMsg.getEndpoint()
   def flags = zclMsg.getFlags()
   def payloadLen = zclMsg.getLength()
   byte[] data = zclMsg.getPayload()

   if (PROFILE_HA == profile) {
      if (CLUSTER_ACCELEROMETER == clusterId) {
         boolean clusterSpecific = (0 != (flags & 0x01))
         if (!clusterSpecific && (CMD_REPORT_ATTR == messageId || CMD_READ_ATTR_RSP == messageId)) {
            log.trace "Driver received Accelerometer Attributes:{}", message
            handleAccelerometerMsg(message)
            return
         }
         if (CMD_WRT_ATTR_RSP == messageId) {
            if (logResponse(data, "Accelerometer threshold write")) vars.CNFG_ACCEL_THRESHOLD = -1
            return
         }
         if (CMD_CNFG_RPT_RSP == messageId) {
            if (logResponse(data, "Accelerometer reporting configuration")) vars.CNFG_ACCEL_RPT = -1
            return
         }
         if (CMD_DFLT_RSP == messageId) {
            // payload is the command id and a status; a device that rejects the
            // manufacturer-specific setup says so here
            if ((null != data) && (2 <= data.size()) && (0x00 != data[1])) {
               log.warn "Accelerometer default response with an error: {}", data
            } else {
               log.trace "Accelerometer default response"
            }
            return
         }
      }
      if (CLUSTER_PWR_CNFG == clusterId && CMD_CNFG_RPT_RSP == messageId) {
         if (logResponse(data, "Power reporting configuration")) vars.CNFG_PWR_RPT = -1
         return
      }
      if (CLUSTER_TEMPERATURE == clusterId && CMD_CNFG_RPT_RSP == messageId) {
         if (logResponse(data, "Temperature reporting configuration")) vars.CNFG_TEMP_RPT = -1
         return
      }
      if (CLUSTER_POLL_CONTROL == clusterId && CMD_WRT_ATTR_RSP == messageId) {
         if (logResponse(data, "Poll Control configuration")) vars.CNFG_POLL_CTRL = -1
         return
      }
      if (CLUSTER_POLL_CONTROL == clusterId && CMD_DFLT_RSP == messageId) {
         log.trace "Poll Control default response"
         return
      }
      if (CLUSTER_IAS_ZONE == clusterId && CMD_DFLT_RSP == messageId) {
         log.trace "IAS Zone default response"
         return
      }
   }

   log.debug "Driver received unhandled zigbee ZCL message Profile:{}, ClusterId:{}, MessageId:{}, EndPoint:{}, Flags:{}, Len:{}, Data:{}",
         profile, clusterId, messageId, endpoint, flags, payloadLen, data
}

boolean logResponse(data, msgType) {
   if ((null != data) && (1 <= data.size()) && (0x00 == data[0])) {
      log.trace "{} was successful: {}", msgType, data
      return true
   }
   log.warn "{} FAILED: {}", msgType, data
   return false
}
