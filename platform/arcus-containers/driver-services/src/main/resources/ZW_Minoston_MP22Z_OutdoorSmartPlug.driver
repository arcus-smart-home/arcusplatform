/**
 * Driver for a Minoston MP22Z Outdoor Smart Plug
 *
 * Z-Wave outdoor on/off smart plug, IP65-rated.
 * Max load: 1800W resistive, 15A.
 *
 * FACTORY RESET:  Click the Z-Wave button 3 times quickly, then hold for at least 10 seconds.
 * PAIR/INCLUDE:   Click the PROG button 5 times quickly while the hub is in inclusion mode.
 * UNPAIR/EXCLUDE: Click the PROG button 5 times quickly while the hub is in exclusion mode.
 *
 * Command Classes:
 *   0x20   (32) Basic
 *   0x25   (37) Switch_Binary
 *   0x55   (85) Transport Service
 *   0x59   (89) Association Group Info
 *   0x5A   (90) Device Reset Locally
 *   0x5E   (94) Z-Wave+ Info
 *   0x6C  (108) Supervision
 *   0x70  (112) Configuration
 *   0x72  (114) Manufacturer_Specific
 *   0x73  (115) Power Level
 *   0x7A  (122) Firmware Update Meta Data
 *   0x85 (-123) Association
 *   0x86 (-122) Version
 *   0x87 (-121) Indicator
 *   0x98 (-104) Security S0
 *   0x9F  (-97) Security S2
 */
import groovy.transform.Field

uses 'zwave.GenericZWaveVersion'


driver          "ZWMinostonMP22ZOutdoorSmartPlugDriver"
description     "Driver for a Minoston MP22Z Outdoor Smart Plug"
version         "2.4"
protocol        "ZWAV"
deviceTypeHint  "Switch"
productId       "d31222"
vendor          "Minoston"
model           "MP22Z"

matcher         'ZWAV:Manufacturer': 0x0312, 'ZWAV:ProductType': 0xFF00, 'ZWAV:ProductId': 0xFF07


////////////////////////////////////////////////////////////////////////////////
// Capability Declarations
////////////////////////////////////////////////////////////////////////////////

capabilities    DevicePower, Switch

DevicePower.source               DevicePower.SOURCE_LINE
DevicePower.linecapable          true
DevicePower.backupbatterycapable false

Switch.state                     Switch.STATE_OFF


////////////////////////////////////////////////////////////////////////////////
// Device Settings
////////////////////////////////////////////////////////////////////////////////

deviceSettings {
   param name: 'ledIndicator', id: 1, size: 1,
       type: 'enum', values: ['0': 'On when load on', '1': 'On when load off', '2': 'Always off'],
       description: 'Parameter 1: LED indicator behavior',
       dflt: 0
   param name: 'autoOffTimer', id: 2, size: 2,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 2: Auto off timer in minutes (0=disabled)',
       dflt: 0
   param name: 'autoOnTimer', id: 4, size: 2,
       type: 'range', min: 0, max: 65535,
       description: 'Parameter 4: Auto on timer in minutes (0=disabled)',
       dflt: 0
   param name: 'stateAfterPowerFailure', id: 6, size: 1,
       type: 'enum', values: ['0': 'Off', '1': 'On', '2': 'Previous state'],
       description: 'Parameter 6: State after power failure',
       dflt: 0
}

@Field final String DEVICE_NAME = "Minoston MP22Z Outdoor Smart Plug"

final int OFFLINE_TIMEOUT_SECS    = 10800       // 3 hrs
final int POLLING_INTERVAL_SEC    = 3600        // every hour


////////////////////////////////////////////////////////////////////////////////
// Driver Lifecycle Callbacks
////////////////////////////////////////////////////////////////////////////////

onAdded {
   log.debug "{} added with Attributes {}", DEVICE_NAME, message.attributes

   DevicePower.sourcechanged  ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : now())
   Switch.state               Switch.STATE_OFF
   Switch.statechanged        ((null != DeviceAdvanced.added.get()) ? DeviceAdvanced.added.get() : now())
}

onConnected {
   log.debug "{} connected", DEVICE_NAME

   ZWave.setOfflineTimeout(OFFLINE_TIMEOUT_SECS)
   ZWave.poll(POLLING_INTERVAL_SEC, ZWave.switch_binary.get)

   ZWave.switch_binary.get()

   // set Association Group 1 to hub
   ZWave.association.set( 1, 1, 0, 0, 0);
}

onDisconnected {
   log.debug "{} disconnected", DEVICE_NAME
}

onRemoved {
   log.debug "{} removed", DEVICE_NAME
}


////////////////////////////////////////////////////////////////////////////////
// Capability Support
////////////////////////////////////////////////////////////////////////////////

setAttributes('swit') {
   def attributes = message.attributes
   for (attribute in attributes) {
      switch (attribute.key) {
         case Switch.state:
            log.debug "{} setting switch state to {}", DEVICE_NAME, attribute.value
            if (attribute.value == Switch.STATE_ON) {
               ZWave.switch_binary.set 0xFF
            } else {
               ZWave.switch_binary.set 0x00
            }
            // read back after a short delay
            ZWave.scheduler.scheduleIn 'DelayedRead', 1000
            break
         default:
            break
      }
   }
}

onEvent('DelayedRead') {
   ZWave.switch_binary.get()
}


////////////////////////////////////////////////////////////////////////////////
// Protocol Message Callbacks
////////////////////////////////////////////////////////////////////////////////

onZWaveMessage.switch_binary.report {
   log.debug "{} reported switch binary value: {}", DEVICE_NAME, message
   def prevState = Switch.state.get()
   byte value = message.command.get('value')
   if (value == 0x00) {
      Switch.state Switch.STATE_OFF
   } else {
      Switch.state Switch.STATE_ON
   }
   if (Switch.state.get() != prevState) {
      Switch.statechanged new Date()
   }
}

onZWaveMessage.basic.report {
   log.debug "{} reported basic value: {}", DEVICE_NAME, message
   def prevState = Switch.state.get()
   byte value = message.command.get('value')
   if (value == 0x00) {
      Switch.state Switch.STATE_OFF
   } else {
      Switch.state Switch.STATE_ON
   }
   if (Switch.state.get() != prevState) {
      Switch.statechanged new Date()
   }
}

onZWaveMessage.configuration.report {
   log.trace "{} Config Report: {}", DEVICE_NAME, message
   byte[] bytes = message.command.recvBytes
   int param = message.command.get('param') & 0xFF
   int byteCnt = message.command.get('level') & 0xFF
   long val1 = message.command.get('val1') & 0xFF
   if (2 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      val1 = (val1 * 256) + val2
   } else if (4 == byteCnt) {
      long val2 = message.command.get('val2') & 0xFF
      long val3 = message.command.get('val3') & 0xFF
      long val4 = message.command.get('val4') & 0xFF
      val1 = (val1 * 256 * 256 * 256) + (val2 * 256 * 256) + (val3 * 256) + val4
   }
   log.debug "{} Config Param:{}, Bytes:{}, Val:{}", DEVICE_NAME, param, byteCnt, val1
}

onZWaveMessage.zwaveplus_info.report {
   def zwVer = message.command.get('zwaveversion')
   def roleType = message.command.get('roletype')
   def nodeType = message.command.get('nodetype')
   log.info "{} ZWave Plus Info, ZWave Ver:{}, RoleType:{}, NodeType:{}", DEVICE_NAME, zwVer, roleType, nodeType
}

onZWaveMessage.device_reset_locally.notification {
   log.info "{} Device Reset Locally Notification", DEVICE_NAME
}

onZWaveNodeInfo {
   log.debug "{} reported Node Info: {}, {}, {}, {}, {}", DEVICE_NAME, message.getNodeId(), message.getStatus(), message.getBasic(), message.getGeneric(), message.getSpecific()
}

onZWaveMessage {
   log.debug "{} received unhandled ZWave message {}", DEVICE_NAME, message
   return false;
}
